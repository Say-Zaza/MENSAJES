rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedAccount(email) {
      return email == 'hombre@chatpareja.app' || email == 'mujer@chatpareja.app';
    }
    function isPairedUser(roomId, uid) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/pairing/$(uid));
    }

    match /rooms/{roomId}/pairing/{userId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null && isAllowedAccount(request.auth.token.email) && request.auth.uid == userId && !isPairedUser(roomId, request.auth.uid);
      allow update: if request.auth != null && isAllowedAccount(request.auth.token.email) && ((request.auth.uid == userId && request.resource.data.role == resource.data.role) || (isPairedUser(roomId, request.auth.uid) && request.resource.data.keys().hasOnly(['pairedAt'])));
      allow delete: if false;
    }

    match /rooms/{roomId}/destacados/{slot} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/destacados/{slot}/items/{itemId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update, delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/settings/{slot} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if false;
    }

    match /rooms/{roomId}/cartas/{cartaId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/wishlist/{itemId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/users/{userId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create, update: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow delete: if false;
    }

    match /rooms/{roomId}/typing/{userId} {
      allow read, write: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/calendar/{eventId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow update, delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId}/reminders/{reminderId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow create: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
      allow update, delete: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }

    match /rooms/{roomId} {
      allow read, write: if request.auth != null && isAllowedAccount(request.auth.token.email) && isPairedUser(roomId, request.auth.uid);
    }
  }
}
