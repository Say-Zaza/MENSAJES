rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función helper: verificar si el usuario está emparejado en esta sala
    function isPairedUser(roomId, uid) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/pairing/$(uid));
    }

    // Función helper: contar usuarios emparejados
    function pairedCount(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/pairing).size();
    }

    // Sala de emparejamiento - solo 2 usuarios permitidos
    match /rooms/{roomId}/pairing/{userId} {
      // Leer: solo si ya estás emparejado o eres el primero en registrarte
      allow read: if request.auth != null && (isPairedUser(roomId, request.auth.uid) || pairedCount(roomId) < 2);
      
      // Escribir (crear tu documento de emparejamiento): solo si hay cupo (<2) y no existes ya
      allow create: if request.auth != null 
        && request.auth.uid == userId
        && !isPairedUser(roomId, request.auth.uid)
        && pairedCount(roomId) < 2;
      
      // No permitir update/delete (emparejamiento es permanente)
      allow update, delete: if false;
    }

    // Mensajes - solo usuarios emparejados
    match /rooms/{roomId}/messages/{messageId} {
      allow read, write: if request.auth != null && isPairedUser(roomId, request.auth.uid);
    }

    // Usuarios (metadatos) - solo usuarios emparejados
    match /rooms/{roomId}/users/{userId} {
      allow read, write: if request.auth != null && isPairedUser(roomId, request.auth.uid);
    }

    // Typing indicators - solo usuarios emparejados
    match /rooms/{roomId}/typing/{userId} {
      allow read, write: if request.auth != null && isPairedUser(roomId, request.auth.uid);
    }

    // Pinned message - solo usuarios emparejados
    match /rooms/{roomId} {
      allow read, write: if request.auth != null && isPairedUser(roomId, request.auth.uid);
    }
  }
}