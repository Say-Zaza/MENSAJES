rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo las 2 cuentas fijas pueden usar la app
    function isAllowedAccount(email) {
      return email == 'hombre@chatpareja.app' || email == 'mujer@chatpareja.app';
    }

    // Slot fijo por email
    function slotForEmail(email) {
      return email == 'hombre@chatpareja.app' ? 'user1' :
             email == 'mujer@chatpareja.app' ? 'user2' : '';
    }

    // Pairing
    match /rooms/{roomId}/pairing/{slot} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update, delete: if false;
    }

    // Destacados
    match /rooms/{roomId}/destacados/{slot} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create, update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Items de destacados (subcoleccion: las rules NO cascadan)
    match /rooms/{roomId}/destacados/{slot}/items/{itemId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create, update, delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Ajustes
    match /rooms/{roomId}/settings/{slot} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create, update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if false;
    }

    // Cartas del buzón (sistema independiente de mensajes)
    match /rooms/{roomId}/cartas/{cartaId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Wishlist / Bucket list compartida
    match /rooms/{roomId}/wishlist/{itemId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Mensajes
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Usuarios
    match /rooms/{roomId}/users/{userId} {
      allow read: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow create, update: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow delete: if false;
    }

    // Typing
    match /rooms/{roomId}/typing/{userId} {
      allow read, write: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Calendario
    match /rooms/{roomId}/calendar/{eventId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update, delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Recordatorios
    match /rooms/{roomId}/reminders/{reminderId} {
      allow read: if request.auth != null && isAllowedAccount(request.auth.token.email);
      allow create: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
      allow update, delete: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }

    // Room (pinned)
    match /rooms/{roomId} {
      allow read, write: if request.auth != null
        && isAllowedAccount(request.auth.token.email);
    }
  }
}
