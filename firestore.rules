rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados (anónimos) pueden leer/escribir mensajes
    match /rooms/{roomId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    // Solo usuarios autenticados pueden leer/escribir la lista de usuarios registrados
    match /rooms/{roomId}/users/{userId} {
      allow read: if request.auth != null;
      // Solo puede escribir su propio documento (o admin puede escribir cualquiera)
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/rooms/$(roomId)/users/$(request.auth.uid)).data.role == 'admin');
    }
    // Indicadores de typing
    match /rooms/{roomId}/typing/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}